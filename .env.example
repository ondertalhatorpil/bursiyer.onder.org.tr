# Canlı sunucu ayarları (docker compose). Bu dosyayı ".env" adıyla kopyalayıp doldurun:
#   cp .env.example .env
# Anahtar/şifre üretmek için (her biri için ayrı çalıştırın):
#   openssl rand -base64 32

# --- Veritabanı (MariaDB konteyneri bu bilgilerle ilk açılışta kurulur) ---
DB_ROOT_PASSWORD=
DB_NAME=burs_kayit
DB_USER=burs
DB_PASSWORD=

# --- Site ---
# Sitenin tam adresi (HTTPS). Birden fazlaysa virgülle ayırın.
CORS_ORIGINS=https://bursiyer.onder.org.tr
# Sunucu Nginx'i + frontend Nginx'i = 2
TRUST_PROXY=2
# Frontend konteynerinin sunucuda dinlediği port (sunucu Nginx'i buraya yönlendirir)
WEB_PORT=8090
# phpMyAdmin'in tam adresi (sonunda / olmalı)
PMA_ABSOLUTE_URI=https://bursiyer.onder.org.tr/phpmyadmin/
LOG_LEVEL=info

# --- Şifreleme anahtarları (32 byte base64: openssl rand -base64 32) ---
# DİKKAT: Bunlar değişirse/kaybolursa kayıtlı kimlik numaraları ve IBAN'lar okunamaz. Güvenli yerde yedekleyin.
ENCRYPTION_KEY=
HASH_KEY=

# --- SMS (Ekomesaj) - canlıda zorunlu ---
SMS_DRIVER=ekomesaj
EKOMESAJ_BASE_URL=http://panel4.ekomesaj.com:9587
EKOMESAJ_USERNAME=
EKOMESAJ_PASSWORD=
EKOMESAJ_SENDER=ONDER iHD
EKOMESAJ_ENCODING=1
EKOMESAJ_OTP_MODE=create
# Teslim raporu webhook'u (isteğe bağlı): uzun rastgele bir değer + sitenin adresi
EKOMESAJ_WEBHOOK_TOKEN=
PUBLIC_API_URL=

# --- İsteğe bağlı ---
# Cloudflare Turnstile gizli anahtarı (boşsa captcha kontrolü yapılmaz)
TURNSTILE_SECRET=
# Aday oturumu (dakika): hareketsizlik / en uzun süre
SESSION_IDLE_MIN=30
SESSION_MAX_MIN=720
