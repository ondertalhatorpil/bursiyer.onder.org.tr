NODE_ENV=development
PORT=4000
# Frontend adres(ler)i, virgülle ayrılmış
CORS_ORIGINS=http://localhost:5173
# Nginx arkasında 1
TRUST_PROXY=0
LOG_LEVEL=info

# Veritabanı (utf8mb4 / utf8mb4_turkish_ci ile oluşturulmalı)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=burs_kayit

# Şifreleme ve HMAC anahtarları - her biri 32 byte base64. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DİKKAT: Canlıda anahtar değişirse şifreli veriler okunamaz. Yedekleyin.
ENCRYPTION_KEY=
HASH_KEY=

# SMS: log = gönderme, kodu konsola yaz (geliştirme) | ekomesaj = gerçek gönderim
SMS_DRIVER=log
EKOMESAJ_BASE_URL=http://panel4.ekomesaj.com:9587
EKOMESAJ_USERNAME=
EKOMESAJ_PASSWORD=
EKOMESAJ_SENDER=ONDER iHD
# Türkçe karakter kodlaması (Ekomesaj'dan teyit edilecek)
EKOMESAJ_ENCODING=1
# OTP uç noktası: create (varsayılan) | otp (Ekomesaj OTP hizmeti tanımlanınca)
EKOMESAJ_OTP_MODE=create
# Teslim raporu webhook'u: rastgele uzun bir değer + backend'in dış adresi
EKOMESAJ_WEBHOOK_TOKEN=
PUBLIC_API_URL=

# Belge klasörü (web kökü dışında)
UPLOAD_DIR=./storage/uploads

# Testler bu veritabanını kullanır (yoksa otomatik oluşturulur). Boşsa <DB_NAME>_test
DB_NAME_TEST=

# Cloudflare Turnstile site + gizli anahtar (ikisi birlikte; boşsa captcha kontrolü yapılmaz)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Aday oturumu (dakika): hareketsizlik / mutlak süre
SESSION_IDLE_MIN=30
SESSION_MAX_MIN=720
