{
  "name": "burs-kayit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ÖNDER Çift Kanatlı Nesil Burs Programı kayıt sistemi - backend",
  "main": "src/index.js",
  "scripts": {
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback --all",
    "db:seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "import:schools": "node scripts/import-schools.js",
    "dev": "node --watch src/index.js | pino-pretty -c -t SYS:HH:MM:ss -i pid,hostname",
    "start": "node src/index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "sms:test": "node scripts/sms-test.js",
    "dev:open": "node scripts/dev-open.js",
    "admin:create": "node scripts/admin-create.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "18.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jest": "^30.5.2",
    "jose": "^6.2.12",
    "knex": "3.3.0",
    "multer": "^2.4.0",
    "mysql2": "3.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/setup/global-setup.js"
  }
}
